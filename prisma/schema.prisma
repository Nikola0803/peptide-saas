// Peptide Command Center — data model
//
// Multi-tenant from the ground up: every row that belongs to a customer's
// workspace hangs off Organization, so the same schema serves both "internal
// use for my own brands" and "sold as a SaaS to other store owners" without
// a rewrite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Long-lived key shown on the Webhooks/Settings page. The WP plugin uses
  // this once, on first install, to self-register the site as a new Brand —
  // this is the "automatic recognition of new websites" handshake.
  apiKey    String   @unique @default(cuid())
  plan      Plan     @default(TRIAL)
  createdAt DateTime @default(now())

  memberships Membership[]
  brands      Brand[]
  products    Product[]
  contacts    Contact[]
  affiliates  Affiliate[]
  orders      Order[]
  webhookLogs WebhookEvent[]
  trackingEvents TrackingEvent[]
  shipstationConfig ShipStationConfig?
  invoices    Invoice[]
  conversations   Conversation[]
  whatsappConfig  WhatsAppConfig?
}

enum Plan {
  TRIAL
  STARTER
  GROWTH
  AGENCY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  memberships Membership[]
}

model Membership {
  id             String       @id @default(cuid())
  role           Role         @default(MEMBER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// ---------------------------------------------------------------------------
// Brands (one row per connected WooCommerce store)
// ---------------------------------------------------------------------------

model Brand {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  name   String
  slug   String // e.g. "brand_alpha" — used as the ?store= query param
  domain String

  status         BrandStatus @default(PENDING)
  // Generated when the site self-registers via the plugin; the plugin signs
  // every subsequent webhook with this so the ingestion endpoint can verify
  // it came from this specific store (see /webhooks page + HMAC note there).
  webhookSecret  String      @default(cuid())
  wooConsumerKey String?
  wooConsumerSecret String?

  // Domain ownership proof for manually-added sites — paste this token
  // anywhere in the homepage's HTML, click Verify, done. Plugin-registered
  // brands skip this (possessing the org API key is already proof enough)
  // and get verifiedAt set immediately.
  verificationToken String?   @unique @default(cuid())
  verifiedAt        DateTime?

  lastSyncedAt   DateTime?
  createdAt      DateTime    @default(now())

  @@unique([organizationId, slug])
  products      StoreMapping[]
  contactLinks  ContactBrandLink[]
  orders        Order[]
  webhookEvents WebhookEvent[]
  trackingConfig TrackingConfig?
  trackingEvents TrackingEvent[]
  invoices       Invoice[]
  conversations  Conversation[]
}

enum BrandStatus {
  PENDING // API key issued, plugin not yet installed / no successful sync
  CONNECTED
  ERROR
}

// ---------------------------------------------------------------------------
// Master product catalog
// ---------------------------------------------------------------------------

model Product {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  sku          String
  chemicalName String
  cogsCents    Int
  masterStock  Int    @default(0)

  coas          CoaDocument[]
  storeMappings StoreMapping[]
  orderItems    OrderItem[]
  lots          ProductLot[]

  createdAt DateTime @default(now())

  @@unique([organizationId, sku])
  @@index([organizationId, masterStock])
}

model ProductLot {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  lotNumber         String
  status            LotStatus @default(ACTIVE)
  coaUrl            String?
  quantityReceived  Int
  quantityRemaining Int
  receivedAt        DateTime  @default(now())
  expiresAt         DateTime?
  recalledAt        DateTime?
  recallReason      String?

  orderItems OrderItem[]

  createdAt DateTime @default(now())

  @@unique([productId, lotNumber])
  @@index([productId, status])
}

enum LotStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  RECALLED
}

model CoaDocument {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  label     String? // e.g. lot/batch number
  createdAt DateTime @default(now())
}

// Links a master Product to its listing on one specific brand's store.
model StoreMapping {
  id                String  @id @default(cuid())
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId         String
  brand             Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId           String
  externalProductId String // WooCommerce product ID on that store
  storePriceCents   Int?

  // For headless storefronts (see /api/store/checkout) that don't have a
  // WooCommerce product id to send — evlv-site's static catalog references
  // products by this slug, and checkout resolves price/stock from it.
  slug   String?
  active Boolean @default(true)

  @@unique([brandId, externalProductId])
  @@unique([brandId, slug])
}

// ---------------------------------------------------------------------------
// Contacts (unified customer identity across brands)
// ---------------------------------------------------------------------------

model Contact {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  email          String
  createdAt      DateTime     @default(now())

  // Set when this contact registered an account on a headless storefront
  // (see /api/store/auth/*). Null for contacts that only ever exist because
  // a WooCommerce order webhook mentioned their email — those can't log in.
  passwordHash String?
  name         String?

  brandLinks ContactBrandLink[]
  orders     Order[]

  @@unique([organizationId, email])
  @@index([organizationId, createdAt])
}

// Per-brand customer identity, so the same email on two WooCommerce stores
// resolves to one Contact but we still know the store-local customer id.
model ContactBrandLink {
  id                 String  @id @default(cuid())
  contact            Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId          String
  brand              Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId            String
  externalCustomerId String?

  @@unique([contactId, brandId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  brand          Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId        String
  contact        Contact?     @relation(fields: [contactId], references: [id])
  contactId      String?

  externalOrderNumber String
  status              OrderStatus
  couponCode          String?
  grossCents          Int
  netProfitCents      Int?
  placedAt            DateTime

  // Storefront checkouts (see /api/store/checkout) that pay by bank
  // transfer / crypto memo rather than a card capture — the reference the
  // customer says they'll pay with, checked manually against the payment
  // rail before the order is moved out of ON_HOLD.
  paymentMemo   String?
  // Which rail the memo above is for — evlv-site's checkout offers
  // cashapp / zelle / venmo as of this writing, but this is free text so a
  // new gateway on the storefront side never needs a CRM migration.
  paymentMethod String?

  items       OrderItem[]
  attribution AffiliateOrderAttribution?

  // ShipStation fulfillment — populated once the order's been pushed and
  // (later) marked shipped, either by our own push or a shipped webhook
  // from ShipStation.
  shipstationOrderId String?
  carrierCode        String?
  trackingNumber     String?
  shippedAt          DateTime?

  // Captured straight from the WooCommerce webhook's `shipping` object —
  // needed to push a usable order (with a printable label) to ShipStation.
  shipToName       String?
  shipToAddress1   String?
  shipToAddress2   String?
  shipToCity       String?
  shipToState      String?
  shipToPostalCode String?
  shipToCountry    String?

  // Fraud/risk review — a manual toggle, not automated scoring, but cheap
  // and often enough: flag on suspicion (mismatched billing/shipping,
  // large first order, etc.), see it at a glance on the order.
  flaggedRisk Boolean @default(false)
  riskReason  String?

  notes   OrderNote[]
  refunds Refund[]
  invoices Invoice[]

  createdAt DateTime @default(now())

  @@unique([brandId, externalOrderNumber])
  @@index([organizationId, placedAt])
  @@index([brandId, placedAt])
}

model OrderNote {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String
  body    String

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Refund {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  type         RefundType
  amountCents  Int
  reason       String?
  status       RefundStatus @default(PENDING)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([orderId])
}

enum RefundType {
  REFUND
  CHARGEBACK
}

enum RefundStatus {
  PENDING
  WON
  LOST
  COMPLETED
}

enum OrderStatus {
  COMPLETED
  PROCESSING
  ON_HOLD
  REFUNDED
}

model OrderItem {
  id            String   @id @default(cuid())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  product       Product? @relation(fields: [productId], references: [id])
  productId     String?
  sku           String
  name          String
  quantity      Int
  unitPriceCents Int

  // Which batch fulfilled this line item — set automatically (FIFO, oldest
  // active lot first) if the product has any lots recorded. This is the
  // whole point of lot tracking: if a batch ever gets recalled, every
  // OrderItem row pointing at it IS the recall list.
  lot   ProductLot? @relation(fields: [lotId], references: [id])
  lotId String?

  @@index([lotId])
}

// ---------------------------------------------------------------------------
// Affiliates
// ---------------------------------------------------------------------------

model Affiliate {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  name        String
  slug        String
  ratePercent Float
  couponCode  String

  attributions AffiliateOrderAttribution[]
  createdAt    DateTime                     @default(now())

  @@unique([organizationId, slug])
}

model AffiliateOrderAttribution {
  id            String    @id @default(cuid())
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId   String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String    @unique
  commissionCents Int
}

// ---------------------------------------------------------------------------
// Webhook ingestion log (every inbound call from a store, verified or not)
// ---------------------------------------------------------------------------

model WebhookEvent {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId        String?

  topic           String
  payload         Json
  signatureValid  Boolean
  processedAt     DateTime?
  error           String?
  createdAt       DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Tracking & Pixels — first-party conversion tracking + server-side relay
// to ad platforms (Meta Conversions API, TikTok Events API, GA4
// Measurement Protocol), so conversions still get credited even when a
// client-side pixel is blocked.
// ---------------------------------------------------------------------------

model TrackingConfig {
  id      String @id @default(cuid())
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId String @unique

  // Safe to expose client-side — the embed snippet on the brand's storefront
  // sends this, never a secret. Rotating it invalidates the old snippet.
  publicKey String @unique @default(cuid())

  metaPixelId       String?
  metaAccessToken   String?
  tiktokPixelId     String?
  tiktokAccessToken String?
  ga4MeasurementId  String?
  ga4ApiSecret      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrackingEvent {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  brand          Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId        String

  eventName  String // page_view | view_content | add_to_cart | lead | purchase | custom
  visitorId  String // first-party cookie id set by the embed snippet
  valueCents Int?
  currency   String?
  properties Json?
  clickIds   Json? // fbclid / ttclid / gclid captured from the landing URL
  pageUrl    String?

  relayedMeta   Boolean @default(false)
  relayedTiktok Boolean @default(false)
  relayedGa4    Boolean @default(false)
  relayError    String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([brandId, eventName, createdAt])
}

// ---------------------------------------------------------------------------
// ShipStation — one connection per organization (ShipStation accounts
// aren't typically split per brand/store the way ad pixels are).
// ---------------------------------------------------------------------------

model ShipStationConfig {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  apiKey    String
  apiSecret String
  // If on, every new order from the live webhook is pushed to ShipStation
  // automatically; if off, pushing is manual only (Shipping page button).
  autoPush  Boolean @default(true)

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Invoices — covers both a simple auto-generated retail receipt (rendered
// on demand straight from an Order, no row needed) and real wholesale
// invoices with their own lifecycle (draft → sent → paid/overdue), which
// can optionally originate from an Order or stand alone for an ad-hoc
// wholesale quote that never touched WooCommerce.
// ---------------------------------------------------------------------------

model Invoice {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  brand          Brand?       @relation(fields: [brandId], references: [id])
  brandId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  orderId        String?

  invoiceNumber String @unique

  customerName    String
  customerEmail   String?
  customerAddress String?

  status  InvoiceStatus @default(DRAFT)
  poNumber String?
  notes    String?

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  paidAt    DateTime?

  subtotalCents Int
  taxCents      Int @default(0)
  totalCents    Int

  lineItems InvoiceLineItem[]

  createdAt DateTime @default(now())

  @@index([organizationId, status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  description    String
  quantity       Int
  unitPriceCents Int
  totalCents     Int
}

// ---------------------------------------------------------------------------
// Support / Communications — one inbox for both channels. Contact-form
// submissions arrive as a single inbound message per Conversation; WhatsApp
// threads are genuinely two-way (inbound + outbound replies).
// ---------------------------------------------------------------------------

model Conversation {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId        String?

  channel       ConversationChannel
  status        ConversationStatus  @default(OPEN)
  contactName   String?
  contactEmail  String?
  contactPhone  String? // E.164, WhatsApp threads are keyed off this

  subject       String? // contact-form submissions often have one
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]

  @@index([organizationId, channel, lastMessageAt])
  @@unique([organizationId, channel, contactPhone])
}

enum ConversationChannel {
  WHATSAPP
  CONTACT_FORM
}

enum ConversationStatus {
  OPEN
  CLOSED
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  direction  MessageDirection
  body       String
  externalId String? // WhatsApp's own message id, for dedup on webhook retries
  readAt     DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@unique([externalId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model WhatsAppConfig {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  phoneNumberId      String // Meta's WhatsApp Business phone number id
  accessToken        String
  appSecret          String // verifies X-Hub-Signature-256 on incoming webhooks
  verifyToken        String // Meta's webhook handshake challenge token
  businessDisplayPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


