// Peptide Command Center — data model
//
// Multi-tenant from the ground up: every row that belongs to a customer's
// workspace hangs off Organization, so the same schema serves both "internal
// use for my own brands" and "sold as a SaaS to other store owners" without
// a rewrite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Long-lived key shown on the Webhooks/Settings page. The WP plugin uses
  // this once, on first install, to self-register the site as a new Brand —
  // this is the "automatic recognition of new websites" handshake.
  apiKey    String   @unique @default(cuid())
  plan      Plan     @default(TRIAL)
  createdAt DateTime @default(now())

  // Where order-notification and other operational emails get sent (e.g.
  // office@evlvpeptides.com) — see src/lib/email.ts. Null = that email just
  // doesn't get sent, everything else still works.
  notifyEmail String?

  // Reserved for the Mailchimp newsletter integration on the Email page —
  // not wired up to anything yet, just gives Settings a place to hold these
  // once that gets built.
  mailchimpApiKey     String?
  mailchimpAudienceId String?

  // Minimum available commission balance an affiliate must clear before
  // /api/store/affiliate/payout-request will let them request a payout.
  affiliateMinPayoutCents Int @default(5000)

  memberships Membership[]
  brands      Brand[]
  products    Product[]
  contacts    Contact[]
  affiliates  Affiliate[]
  wholesaleInquiries WholesaleInquiry[]
  orders      Order[]
  webhookLogs WebhookEvent[]
  trackingEvents TrackingEvent[]
  shipstationConfig ShipStationConfig?
  invoices    Invoice[]
  conversations   Conversation[]
  whatsappConfig  WhatsAppConfig?
  emailTemplates  EmailTemplate[]
  emailAutomations EmailAutomation[]
  suppliers       Supplier[]
  newsletters     Newsletter[]
  media           Media[]
}

enum Plan {
  TRIAL
  STARTER
  GROWTH
  AGENCY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  memberships Membership[]
}

model Membership {
  id             String       @id @default(cuid())
  role           Role         @default(MEMBER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  createdAt      DateTime     @default(now())

  // Only set (and only meaningful) when role is DROPSHIP_AGENT -- which
  // supplier this login represents. requireOrg()/session.ts route a
  // DROPSHIP_AGENT to the restricted /dropship area instead of the normal
  // dashboard, scoped to exactly this supplier's data.
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String?

  @@unique([userId, organizationId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  // A partner/supplier's own login -- see the Supplier model. Scoped to
  // their own products and the order items fulfilled from them; never sees
  // customer email, payment method/memo, or any other supplier's data.
  DROPSHIP_AGENT
}

// ---------------------------------------------------------------------------
// Brands (one row per connected WooCommerce store)
// ---------------------------------------------------------------------------

model Brand {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  name   String
  slug   String // e.g. "brand_alpha" — used as the ?store= query param
  domain String

  status         BrandStatus @default(PENDING)
  // Generated when the site self-registers via the plugin; the plugin signs
  // every subsequent webhook with this so the ingestion endpoint can verify
  // it came from this specific store (see /webhooks page + HMAC note there).
  webhookSecret  String      @default(cuid())
  wooConsumerKey String?
  wooConsumerSecret String?

  // Domain ownership proof for manually-added sites — paste this token
  // anywhere in the homepage's HTML, click Verify, done. Plugin-registered
  // brands skip this (possessing the org API key is already proof enough)
  // and get verifiedAt set immediately.
  verificationToken String?   @unique @default(cuid())
  verifiedAt        DateTime?

  lastSyncedAt   DateTime?
  createdAt      DateTime    @default(now())

  // ── Shop/store profile, used to style marketing emails and shown on the storefront ──
  logoUrl          String? // shown in the CRM UI and used as the header image in marketing emails
  supportEmail     String? // public contact address; also the reply-to on marketing emails
  senderName       String? // "From" display name on marketing emails, e.g. "EVLV Team"
  emailAccentColor String? // hex, e.g. "#B8875A" — used for buttons/links in marketing email templates
  businessAddress  String? // physical mailing address, required on marketing emails for CAN-SPAM compliance

  @@unique([organizationId, slug])
  products      StoreMapping[]
  contactLinks  ContactBrandLink[]
  orders        Order[]
  webhookEvents WebhookEvent[]
  trackingConfig TrackingConfig?
  trackingEvents TrackingEvent[]
  invoices       Invoice[]
  conversations  Conversation[]
}

enum BrandStatus {
  PENDING // API key issued, plugin not yet installed / no successful sync
  CONNECTED
  ERROR
}

// ---------------------------------------------------------------------------
// Master product catalog
// ---------------------------------------------------------------------------

model Product {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  sku          String
  chemicalName String
  cogsCents    Int
  masterStock  Int    @default(0)

  // Variable-product support: SKUs sharing the same variantGroup (e.g.
  // "BPC-157") render as one storefront product with a size/dose selector,
  // each variantLabel (e.g. "10mg") linking to its own priced, stocked SKU.
  variantGroup     String?
  variantLabel     String?
  retailPriceCents Int?

  coas             CoaDocument[]
  storeMappings    StoreMapping[]
  orderItems       OrderItem[]
  lots             ProductLot[]
  supplierProducts SupplierProduct[]

  createdAt DateTime @default(now())

  @@unique([organizationId, sku])
  @@index([organizationId, masterStock])
  @@index([organizationId, variantGroup])
}

model ProductLot {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  lotNumber         String
  status            LotStatus @default(ACTIVE)
  coaUrl            String?
  quantityReceived  Int
  quantityRemaining Int
  receivedAt        DateTime  @default(now())
  expiresAt         DateTime?
  recalledAt        DateTime?
  recallReason      String?

  orderItems OrderItem[]

  createdAt DateTime @default(now())

  @@unique([productId, lotNumber])
  @@index([productId, status])
}

enum LotStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  RECALLED
}

model CoaDocument {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  label     String? // e.g. lot/batch number
  createdAt DateTime @default(now())

  // Set when this COA was uploaded through the media library rather than
  // pasted in as an external URL, so it also shows up in Media and gets
  // cleaned up if that file is ever deleted there.
  media   Media?  @relation(fields: [mediaId], references: [id])
  mediaId String?

  // Whether this COA is actually shown on the storefront (see
  // /api/store/coas). Staff-uploaded COAs publish immediately, same as
  // before this field existed. A COA a dropship supplier uploads himself
  // (uploadedBySupplierId set) starts unpublished -- "we decide which
  // products show it" -- until a staff member reviews and publishes it
  // from the product page.
  published Boolean @default(true)

  uploadedBySupplier   Supplier? @relation(fields: [uploadedBySupplierId], references: [id], onDelete: SetNull)
  uploadedBySupplierId String?
}

// Links a master Product to its listing on one specific brand's store.
model StoreMapping {
  id                String  @id @default(cuid())
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId         String
  brand             Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId           String
  externalProductId String // WooCommerce product ID on that store
  storePriceCents   Int?

  // For headless storefronts (see /api/store/checkout) that don't have a
  // WooCommerce product id to send — evlv-site's static catalog references
  // products by this slug, and checkout resolves price/stock from it.
  slug   String?
  active Boolean @default(true)

  @@unique([brandId, externalProductId])
  @@unique([brandId, slug])
}

// ---------------------------------------------------------------------------
// Contacts (unified customer identity across brands)
// ---------------------------------------------------------------------------

model Contact {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  email          String
  createdAt      DateTime     @default(now())

  // Set when this contact registered an account on a headless storefront
  // (see /api/store/auth/*). Null for contacts that only ever exist because
  // a WooCommerce order webhook mentioned their email — those can't log in.
  passwordHash String?
  name         String?

  // Set from the register form's marketingOptIn checkbox (see
  // /api/store/auth/register). Newsletter sends only ever go to contacts
  // where this is true -- there's no separate "unsubscribed" list, opting
  // out just flips this back off.
  marketingOptIn Boolean @default(false)

  // Set after a successful push to Mailchimp (see lib/mailchimp.ts). Null
  // means either never synced, or marketingOptIn is false and there's
  // nothing to sync -- checked alongside marketingOptIn, not instead of it.
  mailchimpSyncedAt DateTime?

  // Links this contact to their anonymous browsing activity in
  // TrackingEvent (see /api/t's "identify" handling) -- set whenever the
  // storefront learns this contact's email while a visitorId cookie is
  // present (checkout, login). Powers browse/cart/checkout-abandonment
  // emails, which otherwise have no way to know who an anonymous visitor
  // is. Last-seen wins if the same person browses from multiple devices.
  lastVisitorId     String?
  lastVisitorSeenAt DateTime?

  brandLinks       ContactBrandLink[]
  orders           Order[]
  automationSends  EmailAutomationSend[]
  affiliate        Affiliate?
  wholesalePartner WholesalePartner?

  @@unique([organizationId, email])
  @@index([organizationId, createdAt])
  @@index([organizationId, marketingOptIn])
  @@index([organizationId, lastVisitorId])
}

// Per-brand customer identity, so the same email on two WooCommerce stores
// resolves to one Contact but we still know the store-local customer id.
model ContactBrandLink {
  id                 String  @id @default(cuid())
  contact            Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId          String
  brand              Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId            String
  externalCustomerId String?

  @@unique([contactId, brandId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  brand          Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId        String
  contact        Contact?     @relation(fields: [contactId], references: [id])
  contactId      String?

  externalOrderNumber String
  status              OrderStatus
  couponCode          String?
  grossCents          Int
  netProfitCents      Int?
  placedAt            DateTime

  // Storefront checkouts (see /api/store/checkout) that pay by bank
  // transfer / crypto memo rather than a card capture — the reference the
  // customer says they'll pay with, checked manually against the payment
  // rail before the order is moved out of ON_HOLD.
  paymentMemo   String?
  // Which rail the memo above is for — evlv-site's checkout offers
  // cashapp / zelle / venmo as of this writing, but this is free text so a
  // new gateway on the storefront side never needs a CRM migration.
  paymentMethod String?

  items       OrderItem[]
  attribution AffiliateOrderAttribution?

  // ShipStation fulfillment — populated once the order's been pushed and
  // (later) marked shipped, either by our own push or a shipped webhook
  // from ShipStation.
  shipstationOrderId String?
  carrierCode        String?
  trackingNumber     String?
  shippedAt          DateTime?

  // Captured straight from the WooCommerce webhook's `shipping` object —
  // needed to push a usable order (with a printable label) to ShipStation.
  shipToName       String?
  shipToAddress1   String?
  shipToAddress2   String?
  shipToCity       String?
  shipToState      String?
  shipToPostalCode String?
  shipToCountry    String?

  // Fraud/risk review. flaggedRisk/riskReason started as a manual-only
  // toggle; runCheckout in order-engine.ts now also sets these
  // automatically on a simple velocity check (several ON_HOLD orders from
  // the same IP in a short window) — still just a flag for a human to
  // review, never an auto-block. ipAddress/userAgent are captured from the
  // storefront checkout request only (WooCommerce webhooks don't carry
  // this) so review has something to actually go on.
  flaggedRisk Boolean @default(false)
  riskReason  String?
  ipAddress   String?
  userAgent   String?

  // Stock reservation for pay-by-memo storefront orders (see
  // src/lib/stock-release-job.ts). masterStock/SupplierProduct.stock is
  // decremented at checkout like a real sale, but for an order that never
  // gets paid that stock needs to come back — stockReleasedAt is set once
  // it has (by the 24h auto-release job, or a manual "Cancel & release"),
  // so release is idempotent and only ever runs once per order.
  // paymentConfirmedAt is set by staff manually confirming payment
  // (Orders page) — the one thing that actually moves status out of
  // ON_HOLD today, since there was no way to do that at all before this.
  stockReleasedAt   DateTime?
  paymentConfirmedAt DateTime?

  notes   OrderNote[]
  refunds Refund[]
  invoices Invoice[]

  createdAt DateTime @default(now())

  @@unique([brandId, externalOrderNumber])
  @@index([organizationId, placedAt])
  @@index([brandId, placedAt])
}

model OrderNote {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String
  body    String

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Refund {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  type         RefundType
  amountCents  Int
  reason       String?
  status       RefundStatus @default(PENDING)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([orderId])
}

enum RefundType {
  REFUND
  CHARGEBACK
}

enum RefundStatus {
  PENDING
  WON
  LOST
  COMPLETED
}

enum OrderStatus {
  COMPLETED
  PROCESSING
  ON_HOLD
  REFUNDED
}

model OrderItem {
  id            String   @id @default(cuid())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  product       Product? @relation(fields: [productId], references: [id])
  productId     String?
  sku           String
  name          String
  quantity      Int
  unitPriceCents Int

  // Dropshipping — set at checkout time (see runCheckout in
  // order-engine.ts) to whichever Supplier currently has an active
  // SupplierProduct row for this product, so the assignment sticks even if
  // that SupplierProduct is later deactivated or reassigned. Null means
  // fulfilled in-house, same as before this existed.
  supplier          Supplier?               @relation(fields: [supplierId], references: [id])
  supplierId        String?
  fulfillmentStatus ItemFulfillmentStatus   @default(PENDING)
  shippedAt         DateTime?
  trackingNumber    String?
  carrierCode       String?
  invoiceLineItem   SupplierInvoiceLineItem?

  // Which batch fulfilled this line item — set automatically (FIFO, oldest
  // active lot first) if the product has any lots recorded. This is the
  // whole point of lot tracking: if a batch ever gets recalled, every
  // OrderItem row pointing at it IS the recall list.
  lot   ProductLot? @relation(fields: [lotId], references: [id])
  lotId String?

  @@index([lotId])
}

enum ItemFulfillmentStatus {
  PENDING
  SHIPPED
}

// ---------------------------------------------------------------------------
// Suppliers (dropshipping partners) — a Supplier gets its own login
// (Membership.role = DROPSHIP_AGENT, Membership.supplierId set) into a
// restricted /dropship area: only the products they've listed as in stock
// (SupplierProduct) and only the OrderItems assigned to them, never
// customer email/payment info or any other supplier's data. The supplier
// manages their own price/shipping-rate/stock per product (bulk-importable
// from a spreadsheet) — that's what "he's responsible for his own stock"
// means operationally: staff isn't maintaining his numbers for him.
// ---------------------------------------------------------------------------

model Supplier {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  name         String
  contactEmail String?
  active       Boolean @default(true)
  createdAt    DateTime @default(now())

  memberships   Membership[]
  products      SupplierProduct[]
  orderItems    OrderItem[]
  invoices      SupplierInvoice[]
  uploadedCoas  CoaDocument[]
}

// A supplier's own price/shipping-rate/stock for one master-catalog
// product — separate from Product.cogsCents/masterStock (which is
// in-house COGS/inventory) since a dropshipped product isn't in EVLV's own
// warehouse at all. Only one supplier can be *active* for a given product
// at a time (checkout assigns to whichever one is), enforced by the
// partial-unique-ish pattern of just checking `active` in the app layer
// rather than the DB, since a temporarily-deactivated-then-reactivated row
// should keep its history instead of being deleted and recreated.
model SupplierProduct {
  id         String   @id @default(cuid())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String

  costCents     Int // what the supplier bills us for the item itself
  shippingCents Int @default(0) // what the supplier bills us to ship one unit
  stock         Int @default(0) // decremented at checkout, restored on stock release -- see Order.stockReleasedAt
  active        Boolean @default(true)

  // Free-form restock tracking a supplier fills in themselves -- "more
  // details for each product" without inventing a rigid multi-stage
  // pipeline (incoming/ordered/in-transit/etc.) nobody actually specified
  // the states of. A note plus a date covers "400 units arriving the 12th"
  // just as well as a formal state machine would, for a lot less to get
  // wrong.
  restockNote String?
  restockEta  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, productId])
  @@index([productId, active])
}

// Auto-generated (see generateSupplierInvoice in the dropship actions)
// summary of everything a supplier shipped in a period, at their own
// declared cost+shipping rates — this is what "he sends us auto billing"
// means: the CRM computes what we owe him from what he actually shipped,
// he doesn't have to invoice us by hand.
model SupplierInvoice {
  id         String   @id @default(cuid())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String

  periodStart DateTime
  periodEnd   DateTime
  totalCents  Int
  status      SupplierInvoiceStatus @default(DRAFT)

  lineItems SupplierInvoiceLineItem[]
  createdAt DateTime @default(now())

  @@index([supplierId, createdAt])
}

enum SupplierInvoiceStatus {
  DRAFT
  SENT
  PAID
}

model SupplierInvoiceLineItem {
  id          String          @id @default(cuid())
  invoice     SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id])
  orderItemId String          @unique

  costCents     Int
  shippingCents Int
}

// ---------------------------------------------------------------------------
// Affiliates
// ---------------------------------------------------------------------------

model Affiliate {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  // Self-serve applicants are a role on their existing storefront Contact
  // account (evlv-site's affiliate portal was redesigned to authenticate
  // with the customer's own session token, not a separate affiliate
  // login -- see /api/store/affiliate/*). Null for admin-created
  // affiliates that don't correspond to any shopper account.
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactId String?  @unique

  name        String
  slug        String
  ratePercent Float
  couponCode  String

  // Self-serve portal fields (see /affiliates on evlv-site) -- all
  // nullable/defaulted because admin-created affiliates (the original
  // way this model was used) never fill these in.
  email        String?  @unique
  passwordHash String?
  username     String?
  firstName    String?
  lastName     String?
  phone        String?
  socialLink   String?
  address      String?
  city         String?
  province     String?
  postalCode   String?
  country      String?
  referredBy   String?

  status AffiliateStatus @default(PENDING)

  // Payout method — one of these three groups is populated depending on
  // payoutMethod: payoutDestination for Venmo/Zelle/CashApp, the bank*
  // fields for BANK_ACH.
  payoutMethod      PayoutMethod?
  payoutDestination String?
  bankAccountHolder String?
  bankRoutingNumber String?
  bankAccountNumber String?
  bankAccountType   BankAccountType?

  clicks         AffiliateClick[]
  payoutRequests AffiliatePayoutRequest[]
  attributions   AffiliateOrderAttribution[]
  createdAt      DateTime                     @default(now())

  @@unique([organizationId, slug])
}

enum AffiliateStatus {
  PENDING // applied, awaiting manual review
  APPROVED
  REJECTED
}

enum PayoutMethod {
  VENMO
  ZELLE
  CASHAPP
  BANK_ACH
}

enum BankAccountType {
  CHECKING
  SAVINGS
}

// Deliberately minimal -- just a timestamp row, enough to compute
// clicks_30d/clicks_total by counting. No IP/UA tracking needed here.
model AffiliateClick {
  id          String    @id @default(cuid())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId String
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
}

model AffiliatePayoutRequest {
  id          String   @id @default(cuid())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId String

  amountCents Int
  status      PayoutRequestStatus @default(REQUESTED)
  requestedAt DateTime            @default(now())
  paidAt      DateTime?
  adminNote   String?

  @@index([affiliateId, status])
}

enum PayoutRequestStatus {
  REQUESTED
  PAID
  REJECTED
}

model AffiliateOrderAttribution {
  id            String    @id @default(cuid())
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  affiliateId   String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String    @unique
  commissionCents Int
}

// ---------------------------------------------------------------------------
// Wholesale/dropship B2B partners
// ---------------------------------------------------------------------------

// Raw lead from the /wholesale inquiry form -- doesn't require an existing
// Contact (a prospect may never have shopped on EVLV). Staff reviews and,
// once approved, manually links it to a Contact (creating one if needed)
// by creating a WholesalePartner -- see linkWholesaleInquiry in
// src/app/(app)/wholesale/actions.ts.
model WholesaleInquiry {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  companyName   String
  contactName   String
  email         String
  phone         String?
  website       String?
  monthlyVolume String?
  message       String?

  status    WholesaleInquiryStatus @default(NEW)
  createdAt DateTime               @default(now())
}

enum WholesaleInquiryStatus {
  NEW
  LINKED // turned into a WholesalePartner
  REJECTED
}

// A role on an existing Contact account (same pattern as Affiliate),
// created by staff once a WholesaleInquiry is approved and linked.
model WholesalePartner {
  id         String  @id @default(cuid())
  contact    Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId  String  @unique

  status            WholesaleStatus @default(PENDING)
  businessName      String?
  notificationEmail String?

  invoices  WholesaleInvoice[]
  createdAt DateTime           @default(now())
}

enum WholesaleStatus {
  PENDING
  APPROVED
  REJECTED
}

model WholesaleInvoice {
  id        String           @id @default(cuid())
  partner   WholesalePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  label         String // e.g. "August 2026 wholesale order" or an order/batch reference
  amountCents   Int
  status        WholesaleInvoiceStatus @default(UNPAID)
  issuedDate    DateTime               @default(now())
  paidDate      DateTime?
  paymentMethod String? // "zelle" | "cashapp" | "venmo" | "bank_ach" -- same manual payment methods checkout uses
  paymentMemo   String? // what to put in the memo/note when paying, so it's identifiable
}

enum WholesaleInvoiceStatus {
  UNPAID
  PAID
}

// ---------------------------------------------------------------------------
// Webhook ingestion log (every inbound call from a store, verified or not)
// ---------------------------------------------------------------------------
// Media library — images/PDFs uploaded from the CRM itself (product
// photos, COAs, logos) instead of staff having to host files elsewhere
// and paste a URL, which is what every upload-shaped field did before
// this existed. Files live on disk under public/uploads/<organizationId>/
// (see src/app/(app)/media/actions.ts) — this row is just the catalog.
// ---------------------------------------------------------------------------

model Media {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  url        String // public path, e.g. /uploads/<orgId>/<id>-<filename>
  filename   String // original filename, for display
  mimeType   String
  sizeBytes  Int

  uploadedAt DateTime @default(now())

  coaDocuments CoaDocument[]

  @@index([organizationId, uploadedAt])
}

// ---------------------------------------------------------------------------

model WebhookEvent {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId        String?

  topic           String
  payload         Json
  signatureValid  Boolean
  processedAt     DateTime?
  error           String?
  createdAt       DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Tracking & Pixels — first-party conversion tracking + server-side relay
// to ad platforms (Meta Conversions API, TikTok Events API, GA4
// Measurement Protocol), so conversions still get credited even when a
// client-side pixel is blocked.
// ---------------------------------------------------------------------------

model TrackingConfig {
  id      String @id @default(cuid())
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId String @unique

  // Safe to expose client-side — the embed snippet on the brand's storefront
  // sends this, never a secret. Rotating it invalidates the old snippet.
  publicKey String @unique @default(cuid())

  metaPixelId       String?
  metaAccessToken   String?
  tiktokPixelId     String?
  tiktokAccessToken String?
  ga4MeasurementId  String?
  ga4ApiSecret      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrackingEvent {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  brand          Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId        String

  eventName  String // page_view | view_content | add_to_cart | lead | purchase | custom
  visitorId  String // first-party cookie id set by the embed snippet
  valueCents Int?
  currency   String?
  properties Json?
  clickIds   Json? // fbclid / ttclid / gclid captured from the landing URL
  pageUrl    String?

  relayedMeta   Boolean @default(false)
  relayedTiktok Boolean @default(false)
  relayedGa4    Boolean @default(false)
  relayError    String?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([brandId, eventName, createdAt])
}

// ---------------------------------------------------------------------------
// ShipStation — one connection per organization (ShipStation accounts
// aren't typically split per brand/store the way ad pixels are).
// ---------------------------------------------------------------------------

model ShipStationConfig {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  apiKey    String
  apiSecret String
  // If on, every new order from the live webhook is pushed to ShipStation
  // automatically; if off, pushing is manual only (Shipping page button).
  autoPush  Boolean @default(true)

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Invoices — covers both a simple auto-generated retail receipt (rendered
// on demand straight from an Order, no row needed) and real wholesale
// invoices with their own lifecycle (draft → sent → paid/overdue), which
// can optionally originate from an Order or stand alone for an ad-hoc
// wholesale quote that never touched WooCommerce.
// ---------------------------------------------------------------------------

model Invoice {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  brand          Brand?       @relation(fields: [brandId], references: [id])
  brandId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  orderId        String?

  invoiceNumber String @unique

  customerName    String
  customerEmail   String?
  customerAddress String?

  status  InvoiceStatus @default(DRAFT)
  poNumber String?
  notes    String?

  issueDate DateTime  @default(now())
  dueDate   DateTime?
  paidAt    DateTime?

  subtotalCents Int
  taxCents      Int @default(0)
  totalCents    Int

  lineItems InvoiceLineItem[]

  createdAt DateTime @default(now())

  @@index([organizationId, status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

model InvoiceLineItem {
  id             String  @id @default(cuid())
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  description    String
  quantity       Int
  unitPriceCents Int
  totalCents     Int
}

// ---------------------------------------------------------------------------
// Support / Communications — one inbox for both channels. Contact-form
// submissions arrive as a single inbound message per Conversation; WhatsApp
// threads are genuinely two-way (inbound + outbound replies).
// ---------------------------------------------------------------------------

model Conversation {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId        String?

  channel       ConversationChannel
  status        ConversationStatus  @default(OPEN)
  contactName   String?
  contactEmail  String?
  contactPhone  String? // E.164, WhatsApp threads are keyed off this

  subject       String? // contact-form submissions often have one
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]

  @@index([organizationId, channel, lastMessageAt])
  @@unique([organizationId, channel, contactPhone])
}

enum ConversationChannel {
  WHATSAPP
  CONTACT_FORM
}

enum ConversationStatus {
  OPEN
  CLOSED
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  direction  MessageDirection
  body       String
  externalId String? // WhatsApp's own message id, for dedup on webhook retries
  readAt     DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@unique([externalId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model WhatsAppConfig {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  phoneNumberId      String // Meta's WhatsApp Business phone number id
  accessToken        String
  appSecret          String // verifies X-Hub-Signature-256 on incoming webhooks
  verifyToken        String // Meta's webhook handshake challenge token
  businessDisplayPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Email — transactional templates, editable from the Email page. Rendered
// with a tiny {{variable}} substitution (see src/lib/email.ts) and sent via
// whatever provider EMAIL_* env vars configure (Resend by default). A
// built-in default exists in code for every `key` this app sends, so
// nothing breaks before a template row exists — creating one here just
// overrides that default's subject/copy.
// ---------------------------------------------------------------------------

model EmailTemplate {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  // Matches an EMAIL_TEMPLATE_KEYS entry in src/lib/email.ts, e.g.
  // "order_confirmation_customer", "order_confirmation_office".
  key     String
  name    String
  subject String
  html    String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
}

// One row per lifecycle-email flow (see DEFAULT_AUTOMATIONS in
// src/lib/email-automations.ts) -- the operator toggles it on/off and
// tunes its delay from the Email page; the actual trigger condition for
// each key is still flow-specific code in src/lib/automation-job.ts (a
// full drag-and-drop rule builder is out of scope, but timing is real and
// editable). Rows are upserted lazily from DEFAULT_AUTOMATIONS the first
// time the Email page loads for an org, same pattern as EmailTemplate.
model EmailAutomation {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  key         String // matches a DEFAULT_AUTOMATIONS entry, e.g. "welcome_2", "cart_abandonment"
  name        String
  enabled     Boolean   @default(false)
  delayValue  Int       @default(0)
  delayUnit   DelayUnit @default(HOURS)
  templateKey String // which EmailTemplate/DEFAULT_TEMPLATES key this flow sends

  // Only meaningful for the "vip" flow: trailing-90-day spend a contact
  // must cross to get the VIP email. Null for every delay-based flow.
  thresholdCents Int?

  sends EmailAutomationSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
}

enum DelayUnit {
  MINUTES
  HOURS
  DAYS
}

// Dedup log: automation-job.ts checks this before sending so the same
// contact never gets the same flow twice for the same cycle (dedupKey is
// usually the contactId, sometimes contactId+orderId for order-scoped
// flows like shipping/post-purchase).
model EmailAutomationSend {
  id            String          @id @default(cuid())
  automation    EmailAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId  String
  contact       Contact?        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId     String?
  dedupKey      String
  sentAt        DateTime        @default(now())

  @@unique([automationId, dedupKey])
}

// One row per newsletter blast actually sent — a record of what went out
// and to how many people, not a queue (sends happen synchronously from the
// Email page). In-house alternative to Mailchimp: same Resend account and
// Contact list this app already has, no second subscription.
model Newsletter {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  subject         String
  html            String @db.Text
  recipientCount  Int
  failedCount     Int @default(0)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}


