// Peptide Command Center — data model
//
// Multi-tenant from the ground up: every row that belongs to a customer's
// workspace hangs off Organization, so the same schema serves both "internal
// use for my own brands" and "sold as a SaaS to other store owners" without
// a rewrite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & auth
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  // Long-lived key shown on the Webhooks/Settings page. The WP plugin uses
  // this once, on first install, to self-register the site as a new Brand —
  // this is the "automatic recognition of new websites" handshake.
  apiKey    String   @unique @default(cuid())
  plan      Plan     @default(TRIAL)
  createdAt DateTime @default(now())

  // Where order-notification and other operational emails get sent (e.g.
  // office@evlvpeptides.com) — see src/lib/email.ts. Null = that email just
  // doesn't get sent, everything else still works.
  notifyEmail String?

  // Reserved for the Mailchimp newsletter integration on the Email page —
  // not wired up to anything yet, just gives Settings a place to hold these
  // once that gets built.
  mailchimpApiKey     String?
  mailchimpAudienceId String?

  // Minimum available commission balance an affiliate must clear before
  // /api/store/affiliates/payout issues a payout to them. Null = use the
  // 25.00 hard-coded default in that route.
  affiliatePayoutMinimum Decimal? @db.Decimal(10, 2)

  memberships    Membership[]
  brands         Brand[]
  contacts       Contact[]
  orders         Order[]
  affiliates     Affiliate[]
  conversations  Conversation[]
  emailTemplates EmailTemplate[]
  trackingPixels TrackingConfig[]
  coupons        Coupon[]
  suppliers      Supplier[]
  newsletters    Newsletter[]
  media          Media[]
  pushSubscriptions PushSubscription[]
}

enum Plan {
  TRIAL
  STARTER
  PRO
  ENTERPRISE
}

// ---------------------------------------------------------------------------
// Auth / user / memberships
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  memberships Membership[]
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  DROPSHIP_AGENT
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  supplierId     String?        // only set when role = DROPSHIP_AGENT
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id])

  @@unique([userId, organizationId])
}

// ---------------------------------------------------------------------------
// Brands
// ---------------------------------------------------------------------------

model Brand {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  domain         String?
  logoUrl        String?
  platform       String   @default("woocommerce")
  timezone       String   @default("America/New_York")
  currency       String   @default("USD")
  createdAt      DateTime @default(now())

  // WooCommerce REST API credentials for live order sync.
  // Null = the site hasn't been configured yet (plugin installed but not
  // paired, or brand was created manually).
  wcRestUrl        String?
  wcConsumerKey    String?
  wcConsumerSecret String?

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         Order[]
  contacts       Contact[]
  products       Product[]
  trackingPixels TrackingConfig[]
  conversations  Conversation[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Contacts
// ---------------------------------------------------------------------------

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  brandId        String?
  email          String?
  phone          String?  // stored in E.164 format for WhatsApp compatibility
  name           String?
  address        Json?
  tags           String[]
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand         Brand?         @relation(fields: [brandId], references: [id])
  orders        Order[]
  affiliateLink Affiliate?
  segments      ContactSegment[]

  @@index([organizationId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
  ON_HOLD
  FAILED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
}

model Order {
  id             String          @id @default(cuid())
  organizationId String
  brandId        String
  contactId      String?
  externalId     String? // WooCommerce order ID
  status         OrderStatus     @default(PENDING)
  fulfillment    FulfillmentStatus @default(UNFULFILLED)
  total          Decimal         @db.Decimal(10, 2)
  currency       String          @default("USD")
  lineItems      Json            @default("[]")
  shippingAddress Json?
  billingAddress Json?
  notes          String?         @db.Text
  tags           String[]
  source         String?
  paymentMethod  String?
  couponCode     String?
  trackingNumber String?
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  brand         Brand           @relation(fields: [brandId], references: [id])
  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact       Contact?        @relation(fields: [contactId], references: [id])
  fulfillments  Fulfillment[]

  @@index([organizationId, createdAt])
  @@index([brandId])
  @@index([externalId, brandId])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Fulfillments
// ---------------------------------------------------------------------------

model Fulfillment {
  id        String   @id @default(cuid())
  orderId   String
  items     Json     @default("[]")
  carrier   String?
  tracking  String?
  note      String?  @db.Text
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

model Product {
  id             String   @id @default(cuid())
  organizationId String
  brandId        String
  externalId     String? // WooCommerce product ID
  name           String
  sku            String?
  price          Decimal? @db.Decimal(10, 2)
  stock          Int?
  status         String   @default("publish")
  categories     String[]
  images         Json     @default("[]")
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
  @@index([externalId, brandId])
}

// ---------------------------------------------------------------------------
// Affiliates
// ---------------------------------------------------------------------------

enum AffiliateStatus {
  PENDING
  ACTIVE
  PAUSED
  REJECTED
}

model Affiliate {
  id             String          @id @default(cuid())
  organizationId String
  contactId      String          @unique
  code           String          @unique
  commissionRate Decimal         @default(0.10) @db.Decimal(5, 4)
  status         AffiliateStatus @default(PENDING)
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id])
  payouts      Payout[]

  @@index([organizationId])
}

model Payout {
  id          String   @id @default(cuid())
  affiliateId String
  amount      Decimal  @db.Decimal(10, 2)
  method      String?
  note        String?
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  sku            String
  name           String
  description    String?  @db.Text
  stockQty       Int      @default(0)
  reorderPoint   Int      @default(0)
  cost           Decimal? @db.Decimal(10, 2)
  unit           String   @default("unit")
  supplier       String?
  storageLocation String?
  category       String?
  tags           String[]
  coaFileKey     String?  // S3/storage key for uploaded COA PDF
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Support / Conversations
// ---------------------------------------------------------------------------

model Conversation {
  id             String               @id @default(cuid())
  organizationId String
  brandId        String?
  channel        ConversationChannel
  status         ConversationStatus   @default(OPEN)

  contactName   String?
  contactEmail  String?
  contactPhone  String? // E.164, WhatsApp threads are keyed off this
  chatToken     String?  @unique // live-chat widget session token
  pageUrl       String?  // page the visitor was on when they started the chat

  subject       String? // contact-form submissions often have one
  lastMessageAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand?       @relation(fields: [brandId], references: [id])
  messages     Message[]

  @@index([organizationId, lastMessageAt])
}

enum ConversationChannel {
  WHATSAPP
  CONTACT_FORM
  LIVE_CHAT
}

enum ConversationStatus {
  OPEN
  CLOSED
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  body           String           @db.Text
  externalId     String? // WhatsApp message ID etc.
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// ---------------------------------------------------------------------------
// WhatsApp config
// ---------------------------------------------------------------------------

model WhatsAppConfig {
  id                   String  @id @default(cuid())
  organizationId       String  @unique
  phoneNumberId        String
  accessToken          String
  appSecret            String
  verifyToken          String
  businessDisplayPhone String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Tracking pixels
// ---------------------------------------------------------------------------

model TrackingConfig {
  id             String   @id @default(cuid())
  organizationId String
  brandId        String   @unique
  publicKey      String   @unique @default(cuid())
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Contact segments
// ---------------------------------------------------------------------------

model Segment {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  filter         Json     // serialised FilterGroup
  createdAt      DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     ContactSegment[]

  @@unique([organizationId, name])
}

model ContactSegment {
  contactId String
  segmentId String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([contactId, segmentId])
}

// ---------------------------------------------------------------------------
// Email templates
// ---------------------------------------------------------------------------

model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String
  key            String // e.g. "order_confirmation", "support_reply"
  subject        String
  html           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

// ---------------------------------------------------------------------------
// Coupons
// ---------------------------------------------------------------------------

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id             String     @id @default(cuid())
  organizationId String
  code           String
  type           CouponType @default(PERCENT)
  value          Decimal    @db.Decimal(10, 2)
  usageLimit     Int?
  usageCount     Int        @default(0)
  expiresAt      DateTime?
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Suppliers
// ---------------------------------------------------------------------------

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactEmail   String?
  contactPhone   String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model Media {
  id             String   @id @default(cuid())
  organizationId String
  key            String   @unique // storage path / S3 key
  filename       String
  contentType    String
  size           Int
  url            String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Newsletters
// ---------------------------------------------------------------------------

model Newsletter {
  id             String   @id @default(cuid())
  organizationId String

  subject         String
  html            String @db.Text
  recipientCount  Int
  failedCount     Int @default(0)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

model PushSubscription {
  id             String   @id @default(cuid())
  organizationId String
  endpoint       String   @unique
  p256dh         String
  auth           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}
