# Deploying the whole app on your own VPS (recommended — see README's
# "Deploying to your own VPS" section): Postgres runs on the same box as
# the app, so this is just a plain localhost connection. No pooling
# complexity needed — there's no network hop and no third party closing
# idle connections on you.
DATABASE_URL="postgresql://cc_app:REPLACE_ME@localhost:5432/peptides_crm"
DIRECT_URL="postgresql://cc_app:REPLACE_ME@localhost:5432/peptides_crm"

# --- Alternative: hosted Postgres (Neon, Supabase, etc.), app on Vercel ---
# If you go this route instead, use a POOLED connection string for
# DATABASE_URL (PgBouncer) and a direct one for DIRECT_URL, or you'll hit
# "Error in PostgreSQL connection: Error { kind: Closed }" once connections
# idle out between requests:
# DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.../db?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://user:pass@ep-xxxx.../db?sslmode=require"

# NextAuth
# Must exactly match the URL you're loading the app from, including
# scheme — https://your-domain.com in production, http://localhost:3000
# locally. Wrong or unset value is what causes the
# "[next-auth][warn][NEXTAUTH_URL]" warning in the console. Editing .env
# does NOT hot-reload — always restart the app after changing it.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-string"

# Signs the bearer tokens issued by /api/store/auth/login|register for
# headless storefronts (e.g. evlv-site). Falls back to NEXTAUTH_SECRET if
# unset, but a dedicated secret means rotating one doesn't log out every
# storefront customer. Generate with: openssl rand -base64 32
CUSTOMER_AUTH_SECRET="replace-with-a-random-32-byte-string"

# Transactional email (order confirmations, office new-order notifications,
# Support inbox replies to contact-form leads) — see src/lib/email.ts.
# Get RESEND_API_KEY from resend.com after verifying evlvpeptides.com (or
# whichever domain EMAIL_FROM is on) as a sending domain there. Without
# both set, emails are skipped (logged, not sent) rather than erroring.
RESEND_API_KEY=""
EMAIL_FROM="EVLV <orders@evlvpeptides.com>"
